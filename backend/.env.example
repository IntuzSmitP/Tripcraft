# ── LLM Providers ────────────────────────────────────────────────
# At least ONE provider key must be set.
# Active providers are tried in this priority order:
#   1. Gemini  →  2. OpenRouter  →  3. NVIDIA NIM

# --- Gemini (Google) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# --- OpenRouter (300+ models, great for fallback) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- NVIDIA NIM ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── Agent ────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=15
DEFAULT_ORIGIN=Ahmedabad

# ── Auth / Server ────────────────────────────────────────────────
API_BEARER_TOKEN=tripcraft-dev-token
HOST=0.0.0.0
PORT=8000
